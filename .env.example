# Required in production
ADMIN_PASSWORD=          # first-run admin password for the seeded communities; change it after launch
SESSION_SECRET=          # long random string; signs admin cookies
DATABASE_PATH=/data/hearth.db
# Optional
ROOT_DOMAIN=             # e.g. platform.org to enable slug.platform.org
SEED_DEMO_EVENT=false    # true to create the demo Sports Fiesta on first run
APP_URL=                # public address, used in emails and share previews
SMTP_URL=               # smtps://user:app-password@smtp.gmail.com:465 (turns email on)
EMAIL_FROM=
EMAIL_REPLY_TO=
NOTIFY_COPY_TO=         # a copy of every new registration goes here
GCS_BUCKET=             # Cloud Storage bucket for the database snapshot (Cloud Run)
